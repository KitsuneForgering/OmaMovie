<?xml version="1.0" encoding="utf-8"?>
<!-- Half a second (frames 0-14 at 30 fps) of the generated camera clip, found next to this file,
     as melt and Kdenlive write a single-track project. -->
<mlt LC_NUMERIC="C" version="7.40.0" title="relative">
  <profile width="320" height="180" frame_rate_num="30" frame_rate_den="1"/>
  <producer id="producer0" in="0" out="29">
    <property name="length">30</property>
    <property name="resource">../../fixtures/generated/h264_30fps_aac.mp4</property>
    <property name="mlt_service">avformat</property>
  </producer>
  <playlist id="playlist0">
    <entry producer="producer0" in="0" out="14"/>
  </playlist>
  <tractor id="tractor0" in="0" out="14">
    <track producer="playlist0"/>
  </tractor>
</mlt>
