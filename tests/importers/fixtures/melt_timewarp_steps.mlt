  <profile description="automatic" width="320" height="180" progressive="1" sample_aspect_num="1" sample_aspect_den="1" display_aspect_num="16" display_aspect_den="9" frame_rate_num="30" frame_rate_den="1" colorspace="601"/>
  <producer id="producer0" in="0" out="9">
    <property name="length">15</property>
    <property name="eof">pause</property>
    <property name="resource">2:../../fixtures/generated/h264_30fps_steps.mkv</property>
    <property name="aspect_ratio">1</property>
    <property name="seekable">1</property>
    <property name="format">3</property>
    <property name="audio_index">1</property>
    <property name="video_index">0</property>
    <property name="warp_speed">2</property>
    <property name="warp_resource">../../fixtures/generated/h264_30fps_steps.mkv</property>
    <property name="mlt_service">timewarp</property>
  </producer>
  <producer id="producer1" in="20" out="29">
