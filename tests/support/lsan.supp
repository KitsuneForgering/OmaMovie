# LeakSanitizer suppressions for third-party code (BUILD=asan). Only one-time allocations made by
# drivers and libraries outside OmaMovie belong here; never suppress a frame from libs/ or tests/.

# Vulkan drivers: process-lifetime state created under pthread_once (llvmpipe initializes LLVM).
leak:libvulkan_lvp.so
leak:libvulkan_intel.so
leak:libvulkan_radeon.so
leak:libLLVM

# FFmpeg 9.0.1: mapping VA-API frames into Vulkan (av_hwframe_map, direct or through DRM) leaves a
# reference cycle that keeps the VA-API device, its surface pool and the derived Vulkan frames
# context alive (~200 KB per decoder, constant per session). Reproduced with plain FFmpeg and an
# FFmpeg-created Vulkan device, no OmaMovie code involved (Docs/spikes/S2-ffmpeg-own-device.md).
# Only reachable on machines with VA-API (not in CI). Remove once FFmpeg fixes the cycle.
leak:av_hwframe_map
leak:av_hwframe_ctx_create_derived
leak:av_hwframe_ctx_init
leak:av_hwframe_get_buffer
leak:av_hwdevice_ctx_create
leak:oma::media::ff::wrap_vulkan_device
leak:iHD_drv_video.so
leak:libigdgmm.so
leak:libva.so

# PipeWire 1.x: client modules loaded while creating a stream's context (pw_context_load_module,
# e.g. module-rt talking to RTKit over D-Bus) keep allocations after pw_stream_destroy; the module
# is unloaded by then, so the frames are unsymbolized. Only reachable where a PipeWire daemon
# answers (not in CI).
leak:pw_context_load_module
