#version 460
// Composites one layer into the working image (linear BT.709, premultiplied RGBA16F). With
// blur or sharpen, four earlier passes of this shader blur the source first, into RGBA16F
// images: passes 4 and 3 linearize and reduce it, pass 1 blurs across, pass 2 down; pass 0
// composites, reading the result bilinearly (src/look.hpp Detail).
// The CPU reference in src/cpu_compositor.cpp performs the same steps; keep them in sync,
// and the uniform block in sync with LayerParams (src/layer_params.hpp).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Pass {
    int index; // 0 composite, 1 blur across, 2 blur down, 3 reduce down, 4 reduce across
} P;

layout(set = 0, binding = 0, rgba16f) uniform image2D target; // pass 0: the output
layout(set = 0, binding = 1) uniform sampler2D plane0; // luma
layout(set = 0, binding = 2) uniform sampler2D plane1; // Cb (planar) or CbCr (interleaved)
layout(set = 0, binding = 3) uniform sampler2D plane2; // Cr (planar), unused otherwise
// Pass 3: the source reduced across. Pass 1: the reduced source. Pass 2: the horizontal blur.
// Pass 0: the blurred source (a 1x1 placeholder without detail).
layout(set = 0, binding = 5) uniform sampler2D blurred;
// Passes 1-4: where the pass writes (a 1x1 placeholder in pass 0).
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D blur_target;
// The layer's 3D LUT, red along x (a 1x1x1 placeholder without one). Read with texelFetch and
// interpolated tetrahedrally, as the CPU reference does.
layout(set = 0, binding = 7) uniform sampler3D lut;

layout(std140, set = 0, binding = 4) uniform Layer {
    vec4 inv0;    // output -> source: a, b, tx
    vec4 inv1;    // c, d, ty
    vec4 crop;    // x0, y0, x1, y1 in source pixels
    vec4 yuv_r;   // R' = dot(yuv_r.xyz, yuv) + yuv_r.w
    vec4 yuv_g;
    vec4 yuv_b;
    vec4 gamut_r; // linear source primaries -> BT.709
    vec4 gamut_g;
    vec4 gamut_b;
    vec4 misc;    // opacity, sample scale, reveal edge in output pixels (negative: none)
    ivec4 mode;   // chroma mode (1 interleaved, 2 planar), chroma shift x, chroma shift y, transfer
    ivec4 extra;  // blend, source width, source height
    ivec4 region; // output pixels x0, y0, x1, y1
    vec4 gains;   // look (src/look.hpp): r, g, b gains, contrast power
    vec4 look_r;  // look matrix rows, offset in w
    vec4 look_g;
    vec4 look_b;
    vec4 vignette; // darkening, center x, center y (source pixels), 1 / corner distance
    vec4 detail;   // blur/sharpen (src/look.hpp Detail): mode, sharpen amount, radius, factor
    vec4 weights[5]; // gaussian weights, center first
    ivec4 grade;       // stages (1 CDL, 2 curves, 4 LUT), LUT size
    vec4 lut_amount;   // x: mix with the LUT result
    vec4 cdl_slope;    // w: saturation
    vec4 cdl_offset;
    vec4 cdl_power;
    vec4 lut_min;      // LUT domain minimum
    vec4 lut_scale;    // (size - 1) / domain extent
    ivec4 curve_count; // points of the master, red, green and blue curves
    vec4 curve[64];    // x, y, tangent; 16 per curve
} L;

const int kGradeCdl = 1;
const int kGradeCurves = 2;
const int kGradeLut = 4;

const int kDetailBlur = 1;
const int kDetailSharpen = 2;

const float kContrastPivot = 0.18;
const float kVignetteStart = 0.45;
const float kVignetteEnd = 1.0;

const int kTransferLinear = 0;
const int kTransferSrgb = 1;

const int kBlendAdd = 1;
const int kBlendMultiply = 2;
const int kBlendScreen = 3;

float to_linear(float v) {
    v = clamp(v, 0.0, 1.0);
    if (L.mode.w == kTransferLinear) {
        return v;
    }
    if (L.mode.w == kTransferSrgb) {
        return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
    }
    return pow(v, 2.4); // BT.1886
}

// The inverse of to_linear: the layer's code values, the grading space (ADR-0012).
float from_linear(float v) {
    v = clamp(v, 0.0, 1.0);
    if (L.mode.w == kTransferLinear) {
        return v;
    }
    if (L.mode.w == kTransferSrgb) {
        return v <= 0.0031308 ? v * 12.92 : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
    }
    return pow(v, 1.0 / 2.4);
}

// Curve c (0 master, 1-3 red, green, blue) at x: monotone cubic Hermite through its points.
float curve(int c, float x) {
    int n = L.curve_count[c];
    if (n == 0) {
        return x;
    }
    int base = c * 16;
    if (x <= L.curve[base].x) {
        return L.curve[base].y;
    }
    if (x >= L.curve[base + n - 1].x) {
        return L.curve[base + n - 1].y;
    }
    int k = 0;
    while (k + 2 < n && x >= L.curve[base + k + 1].x) {
        ++k;
    }
    vec4 p0 = L.curve[base + k];
    vec4 p1 = L.curve[base + k + 1];
    float h = p1.x - p0.x;
    float t = (x - p0.x) / h;
    float t2 = t * t;
    float t3 = t2 * t;
    return (2.0 * t3 - 3.0 * t2 + 1.0) * p0.y + (t3 - 2.0 * t2 + t) * h * p0.z +
           (-2.0 * t3 + 3.0 * t2) * p1.y + (t3 - t2) * h * p1.z;
}

vec3 lut_at(ivec3 i) {
    return texelFetch(lut, i, 0).rgb;
}

// Tetrahedral interpolation of the LUT: four entries, greys stay grey.
vec3 lut_sample(vec3 e) {
    int n = L.grade.y;
    vec3 s = clamp((e - L.lut_min.xyz) * L.lut_scale.xyz, vec3(0.0), vec3(float(n - 1)));
    ivec3 i = min(ivec3(floor(s)), ivec3(n - 2));
    vec3 f = s - vec3(i);
    vec3 v1;
    vec3 v2;
    vec4 w;
    if (f.r >= f.g && f.g >= f.b) {
        v1 = lut_at(i + ivec3(1, 0, 0)); v2 = lut_at(i + ivec3(1, 1, 0)); w = vec4(1.0 - f.r, f.r - f.g, f.g - f.b, f.b);
    } else if (f.r >= f.b && f.b > f.g) {
        v1 = lut_at(i + ivec3(1, 0, 0)); v2 = lut_at(i + ivec3(1, 0, 1)); w = vec4(1.0 - f.r, f.r - f.b, f.b - f.g, f.g);
    } else if (f.b > f.r && f.r >= f.g) {
        v1 = lut_at(i + ivec3(0, 0, 1)); v2 = lut_at(i + ivec3(1, 0, 1)); w = vec4(1.0 - f.b, f.b - f.r, f.r - f.g, f.g);
    } else if (f.g > f.r && f.r >= f.b) {
        v1 = lut_at(i + ivec3(0, 1, 0)); v2 = lut_at(i + ivec3(1, 1, 0)); w = vec4(1.0 - f.g, f.g - f.r, f.r - f.b, f.b);
    } else if (f.g >= f.b && f.b > f.r) {
        v1 = lut_at(i + ivec3(0, 1, 0)); v2 = lut_at(i + ivec3(0, 1, 1)); w = vec4(1.0 - f.g, f.g - f.b, f.b - f.r, f.r);
    } else {
        v1 = lut_at(i + ivec3(0, 0, 1)); v2 = lut_at(i + ivec3(0, 1, 1)); w = vec4(1.0 - f.b, f.b - f.g, f.g - f.r, f.r);
    }
    return w.x * lut_at(i) + w.y * v1 + w.z * v2 + w.w * lut_at(i + ivec3(1));
}

// The layer's grade (include/oma/compositor/grade.hpp): CDL, curves, LUT in the grading space.
vec3 grade(vec3 c) {
    vec3 e = vec3(from_linear(c.r), from_linear(c.g), from_linear(c.b));
    if ((L.grade.x & kGradeCdl) != 0) {
        e = pow(clamp(e * L.cdl_slope.rgb + L.cdl_offset.rgb, 0.0, 1.0), L.cdl_power.rgb);
        float luma = dot(vec3(0.2126, 0.7152, 0.0722), e);
        e = clamp(luma + L.cdl_slope.w * (e - luma), 0.0, 1.0);
    }
    if ((L.grade.x & kGradeCurves) != 0) {
        e = vec3(curve(1, curve(0, e.r)), curve(2, curve(0, e.g)), curve(3, curve(0, e.b)));
    }
    if ((L.grade.x & kGradeLut) != 0) {
        e = mix(e, lut_sample(e), L.lut_amount.x);
    }
    return vec3(to_linear(e.r), to_linear(e.g), to_linear(e.b));
}

// Linear BT.709 RGB of one source pixel.
vec3 texel(ivec2 p) {
    float scale = L.misc.y;
    float y = texelFetch(plane0, p, 0).r * scale;
    ivec2 c = ivec2(p.x >> L.mode.y, p.y >> L.mode.z);
    float cb;
    float cr;
    if (L.mode.x == 1) {
        vec2 v = texelFetch(plane1, c, 0).rg;
        cb = v.x * scale;
        cr = v.y * scale;
    } else {
        cb = texelFetch(plane1, c, 0).r * scale;
        cr = texelFetch(plane2, c, 0).r * scale;
    }
    vec3 yuv = vec3(y, cb, cr);
    vec3 nonlinear = vec3(dot(L.yuv_r.xyz, yuv) + L.yuv_r.w,
                          dot(L.yuv_g.xyz, yuv) + L.yuv_g.w,
                          dot(L.yuv_b.xyz, yuv) + L.yuv_b.w);
    vec3 lin = vec3(to_linear(nonlinear.r), to_linear(nonlinear.g), to_linear(nonlinear.b));
    return vec3(dot(L.gamut_r.xyz, lin), dot(L.gamut_g.xyz, lin), dot(L.gamut_b.xyz, lin));
}

// The cropped source's texel bounds, where bilinear taps and blur taps clamp.
void tap_bounds(out ivec2 lo, out ivec2 hi) {
    lo = clamp(ivec2(floor(L.crop.xy)), ivec2(0), L.extra.yz - 1);
    hi = clamp(ivec2(ceil(L.crop.zw)) - 1, ivec2(0), L.extra.yz - 1);
}

float weight(int i) {
    int k = abs(i);
    return L.weights[k >> 2][k & 3];
}

// The last texel of the reduced image: it covers the cropped source from `lo`, `factor` source
// texels per reduced texel.
ivec2 reduced_last(ivec2 lo, ivec2 hi) {
    return (hi - lo) / int(L.detail.w);
}

// Passes 4 and 3: the linear source reduced by a factor x factor box average, run across (each
// cropped source row into `factor` times fewer texels) then down, taps clamped to the cropped
// source. Separable so no thread averages factor^2 texels alone. Mirrored by blurred_source() in
// src/cpu_compositor.cpp, like the passes below.
void reduce_across_pass() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy); // reduced column, cropped source row
    ivec2 lo;
    ivec2 hi;
    tap_bounds(lo, hi);
    if (q.x > reduced_last(lo, hi).x || q.y > hi.y - lo.y) {
        return;
    }
    int f = int(L.detail.w);
    vec3 sum = vec3(0.0);
    for (int i = 0; i < f; ++i) {
        sum += texel(ivec2(min(lo.x + q.x * f + i, hi.x), lo.y + q.y));
    }
    imageStore(blur_target, q, vec4(sum / float(f), 1.0));
}

void reduce_down_pass() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lo;
    ivec2 hi;
    tap_bounds(lo, hi);
    if (any(greaterThan(q, reduced_last(lo, hi)))) {
        return;
    }
    int f = int(L.detail.w);
    vec3 sum = vec3(0.0);
    for (int j = 0; j < f; ++j) {
        sum += texelFetch(blurred, ivec2(q.x, min(q.y * f + j, hi.y - lo.y)), 0).rgb;
    }
    imageStore(blur_target, q, vec4(sum / float(f), 1.0));
}

// Passes 1 and 2: one separable gaussian pass over the reduced image.
void blur_pass(bool down) {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lo;
    ivec2 hi;
    tap_bounds(lo, hi);
    ivec2 last = reduced_last(lo, hi);
    if (any(greaterThan(q, last))) {
        return;
    }
    int radius = int(L.detail.z);
    vec3 sum = vec3(0.0);
    for (int i = -radius; i <= radius; ++i) {
        ivec2 t = down ? ivec2(q.x, clamp(q.y + i, 0, last.y)) : ivec2(clamp(q.x + i, 0, last.x), q.y);
        sum += weight(i) * texelFetch(blurred, t, 0).rgb;
    }
    imageStore(blur_target, q, vec4(sum, 1.0));
}

// The blurred image at source texel p: bilinear between the reduced texels around its center.
vec3 blurred_at(ivec2 p) {
    ivec2 lo;
    ivec2 hi;
    tap_bounds(lo, hi);
    ivec2 last = reduced_last(lo, hi);
    vec2 u = (vec2(p - lo) + 0.5) / L.detail.w - 0.5;
    vec2 base = floor(u);
    vec2 t = u - base;
    ivec2 q0 = clamp(ivec2(base), ivec2(0), last);
    ivec2 q1 = clamp(ivec2(base) + 1, ivec2(0), last);
    vec3 b00 = texelFetch(blurred, ivec2(q0.x, q0.y), 0).rgb;
    vec3 b10 = texelFetch(blurred, ivec2(q1.x, q0.y), 0).rgb;
    vec3 b01 = texelFetch(blurred, ivec2(q0.x, q1.y), 0).rgb;
    vec3 b11 = texelFetch(blurred, ivec2(q1.x, q1.y), 0).rgb;
    return mix(mix(b00, b10, t.x), mix(b01, b11, t.x), t.y);
}

// The source texel after blur or sharpen.
vec3 detailed(ivec2 p) {
    int mode = int(L.detail.x);
    if (mode != kDetailBlur && mode != kDetailSharpen) {
        return texel(p);
    }
    vec3 b = blurred_at(p);
    if (mode == kDetailBlur) {
        return b;
    }
    vec3 o = texel(p);
    return o + L.detail.y * (o - b);
}

void main() {
    if (P.index == 4) {
        reduce_across_pass();
        return;
    }
    if (P.index == 3) {
        reduce_down_pass();
        return;
    }
    if (P.index != 0) {
        blur_pass(P.index == 2);
        return;
    }
    ivec2 out_px = L.region.xy + ivec2(gl_GlobalInvocationID.xy);
    if (out_px.x >= L.region.z || out_px.y >= L.region.w) {
        return;
    }
    vec2 o = vec2(out_px) + 0.5;
    vec2 s = vec2(L.inv0.x * o.x + L.inv0.y * o.y + L.inv0.z,
                  L.inv1.x * o.x + L.inv1.y * o.y + L.inv1.z);
    if (s.x < L.crop.x || s.y < L.crop.y || s.x >= L.crop.z || s.y >= L.crop.w) {
        return;
    }

    // Bilinear filtering in linear light, taps clamped to the cropped area.
    ivec2 lo;
    ivec2 hi;
    tap_bounds(lo, hi);
    vec2 f = s - 0.5;
    vec2 base = floor(f);
    vec2 t = f - base;
    ivec2 p0 = clamp(ivec2(base), lo, hi);
    ivec2 p1 = clamp(ivec2(base) + 1, lo, hi);
    vec3 c00 = detailed(ivec2(p0.x, p0.y));
    vec3 c10 = detailed(ivec2(p1.x, p0.y));
    vec3 c01 = detailed(ivec2(p0.x, p1.y));
    vec3 c11 = detailed(ivec2(p1.x, p1.y));
    vec3 color = mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);

    // The layer's look, in the order of src/look.hpp.
    color = max(color * L.gains.rgb, vec3(0.0));
    if (L.gains.w != 1.0) {
        color = kContrastPivot * pow(color / kContrastPivot, vec3(L.gains.w));
    }
    color = vec3(dot(L.look_r.xyz, color) + L.look_r.w,
                 dot(L.look_g.xyz, color) + L.look_g.w,
                 dot(L.look_b.xyz, color) + L.look_b.w);
    if (L.vignette.x > 0.0) {
        float d = length(s - L.vignette.yz) * L.vignette.w;
        color *= 1.0 - L.vignette.x * smoothstep(kVignetteStart, kVignetteEnd, d);
    }
    color = max(color, vec3(0.0));
    if (L.grade.x != 0) {
        color = grade(color);
    }

    float alpha = L.misc.x;
    if (L.misc.z >= 0.0) {
        alpha *= clamp(L.misc.z - float(out_px.x), 0.0, 1.0); // pixel coverage left of the edge
    }
    vec4 src = vec4(color * alpha, alpha);
    vec4 dst = imageLoad(target, out_px);
    vec4 result;
    if (L.extra.x == kBlendAdd) {
        result = vec4(src.rgb + dst.rgb, src.a + dst.a * (1.0 - src.a));
    } else if (L.extra.x == kBlendMultiply) {
        result = vec4(src.rgb * dst.rgb + src.rgb * (1.0 - dst.a) + dst.rgb * (1.0 - src.a),
                      src.a + dst.a * (1.0 - src.a));
    } else if (L.extra.x == kBlendScreen) {
        result = vec4(src.rgb + dst.rgb - src.rgb * dst.rgb, src.a + dst.a * (1.0 - src.a));
    } else {
        result = src + dst * (1.0 - src.a);
    }
    imageStore(target, out_px, result);
}
